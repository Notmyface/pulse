# Supabase (0$ Free Tier)
# https://supabase.com dashboard'unuzdan
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Cloudflare R2 (10 GB Ücretsiz Depolama - 0$ Egress)
# https://dash.cloudflare.com > R2 bölümünden
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=pulse-attachments
NEXT_PUBLIC_R2_PUBLIC_DOMAIN=https://cdn.yourdomain.com

# Web Push Bildirimleri (VAPID Anahtarları - Ücretsiz)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_public_vapid_key
VAPID_PRIVATE_KEY=your_private_vapid_key
